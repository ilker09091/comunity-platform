# Compose root env — copy to .env and change ALL secrets before deploy.
NODE_ENV=production

# Database
DB_USERNAME=postgres
DB_PASSWORD=change-me-strong-db-password
DB_NAME=communitiy_database
DB_PORT=5432

# JWT secrets — 32+ random chars each, must differ.
# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE-WITH-32-CHAR-RANDOM-STRING
JWT_REFRESH_SECRET=REPLACE-WITH-DIFFERENT-32-CHAR-RANDOM-STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Signed-URL secret for media. Generate: openssl rand -hex 32
MEDIA_URL_SECRET=REPLACE-WITH-32-CHAR-RANDOM-STRING

# API — reachable public URL for your domain
API_PREFIX=api
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
PUBLIC_BASE_URL=https://api.yourdomain.com
CORS_ORIGINS=https://yourdomain.com
LOG_FORMAT=json
TRUST_PROXY=1

# Ports exposed on the host (map behind nginx/caddy in production)
API_PORT=3002
WEB_PORT=3000

# Web (Next.js)
# Server-to-server inside compose network. External users don't see this.
INTERNAL_API_ORIGIN=http://api:3002
# Set to true when the site is served over HTTPS (secure cookies).
SESSION_COOKIE_SECURE=true
