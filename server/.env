# ---- Required ----
PORT=3002
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=communitiy_database
# Ignored: the schema is managed by migrations only (npm run migration:run).
DB_SYNCHRONIZE=false
JWT_SECRET=change-me-access-secret-min-32-chars-xxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-different-xxx
JWT_REFRESH_EXPIRES_IN=7d

# ---- Optional (defaults shown) ----
NODE_ENV=development
API_PREFIX=api
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
PUBLIC_BASE_URL=http://localhost:3002        # used to build signed media URLs
CORS_ORIGINS=http://localhost:3000           # comma-separated frontend origins
TRUST_PROXY=0                                # hop count when behind a reverse proxy
LOG_FORMAT=pretty                            # json in production
DB_SSL=false
DB_POOL_SIZE=10
THROTTLE_ENABLED=true
THROTTLE_LIMIT=300                           # requests per IP per window
THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10                       # login/register/change-password per IP per window
AUTH_THROTTLE_TTL_SECONDS=60
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=./storage/media
# MEDIA_URL_SECRET=                            # REQUIRED in production (defaults to a key derived from JWT_SECRET)
MEDIA_URL_TTL=24h
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_IMAGE_DIMENSION=2048
MEDIA_ORPHAN_TTL_HOURS=24
MEDIA_CLEANUP_ENABLED=true
POST_MAX_LENGTH=5000
POST_MAX_MEDIA=4
COMMENT_MAX_LENGTH=2000
COMMENT_MAX_DEPTH=6
EXPLORE_WINDOW_HOURS=72
# TEST_DB_NAME=communitiy_database_test        # e2e tests; must end with _test
