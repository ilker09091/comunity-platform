node_modules/
**/node_modules/

# Build output (produced by Dockerfile — don't commit)
*.tsbuildinfo
.next/
**/.next/
dist/
server/dist/
.turbo/

# Local secrets: every .env file stays on its machine; only the *.example templates are committed.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.yedek
docker-compose.yml.backup

# Runtime state (importer; recreated on start)
.tools/

# System
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Local Python caches and private runtime credentials
**/__pycache__/
server/storage/

# Local test accounts for design screenshots (never commit)
*.local.json

# Raw generated art (sliced into public/baby by scripts; too big to commit)
client/public/baby/raw/
