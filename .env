# Docker Compose root env (copy to .env and tweak secrets)
NODE_ENV=production
PORT=3002

# Database
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=communitiy_database
DB_PORT=5432

# JWT (production icin degistirin, 32+ karakter)
JWT_SECRET=change-me-access-secret-min-32-chars-xxx
JWT_REFRESH_SECRET=change-me-refresh-secret-different-xxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PREFIX=api
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
PUBLIC_BASE_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000
LOG_FORMAT=pretty
